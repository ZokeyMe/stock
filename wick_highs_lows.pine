//@version=5
indicator("Wick Highs & Lows", overlay=true)

// ─── Inputs ────────────────────────────────────────────────────
minBodyPct = input.float(0.0, "Min body size (% of bar range)", minval=0.0, maxval=100.0,
     tooltip="Ignore near-doji candles. 0 = accept any body. Try 20–30 to filter weak reversals.")

// ─── Candle color (with body-size filter) ──────────────────────
barRange = high - low
bodyPct  = barRange > 0 ? math.abs(close - open) / barRange * 100 : 0
bigEnough = bodyPct >= minBodyPct

isRed   = close < open and bigEnough
isGreen = close > open and bigEnough

// ─── LOW: red bar followed by green bar ────────────────────────
// pick whichever of the two candles has the lower wick (lowest low)
lowSignal = isRed[1] and isGreen
swingLow  = lowSignal ? math.min(low[1], low) : na
lowBar    = lowSignal ? (low[1] <= low ? bar_index - 1 : bar_index) : na

// ─── HIGH: green bar followed by red bar ───────────────────────
// pick whichever of the two candles has the higher wick (highest high)
highSignal = isGreen[1] and isRed
swingHigh  = highSignal ? math.max(high[1], high) : na
highBar    = highSignal ? (high[1] >= high ? bar_index - 1 : bar_index) : na

// ─── Draw markers ──────────────────────────────────────────────
if lowSignal
    label.new(lowBar, swingLow, "L",
         yloc=yloc.price,
         color=color.new(color.green, 0),
         textcolor=color.white,
         style=label.style_label_up,
         size=size.small)

if highSignal
    label.new(highBar, swingHigh, "H",
         yloc=yloc.price,
         color=color.new(color.red, 0),
         textcolor=color.white,
         style=label.style_label_down,
         size=size.small)

// ─── Alerts ────────────────────────────────────────────────────
alertcondition(lowSignal,  title="New Low",  message="Red→Green reversal: new swing low")
alertcondition(highSignal, title="New High", message="Green→Red reversal: new swing high")
