//@version=5
strategy("Market Structure Break", shorttitle="MSB", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0,
     pyramiding=20, calc_on_every_tick=false, process_orders_on_close=false)

// ─── Detection ─────────────────────────────────────────────────
leftBars   = input.int(3, "Pivot Left Bars",  minval=1)
rightBars  = input.int(3, "Pivot Right Bars", minval=1)
useClose   = input.bool(true, "Confirm break with close (vs wick)")

// ─── Colors ────────────────────────────────────────────────────
bullBOSCol   = input.color(color.lime,   "Bullish BOS",   group="Colors")
bearBOSCol   = input.color(color.red,    "Bearish BOS",   group="Colors")
bullCHoCHCol = input.color(color.aqua,   "Bullish CHoCH", group="Colors")
bearCHoCHCol = input.color(color.orange, "Bearish CHoCH", group="Colors")

// ─── Style ─────────────────────────────────────────────────────
lineW         = input.int(2, "Line Width", minval=1, maxval=5, group="Style")
showLabels    = input.bool(true, "Show Labels", group="Style")
showPivots    = input.bool(true, "Show Swing Markers", group="Style")
pivotHighCol  = input.color(color.green, "Pivot High Color", group="Style")
pivotLowCol   = input.color(color.red,   "Pivot Low Color",  group="Style")

// ─── Zigzag ────────────────────────────────────────────────────
showZigzag = input.bool(false, "Show Zigzag", group="Zigzag")
zigzagCol  = input.color(color.yellow, "Zigzag Color", group="Zigzag")
zigzagW    = input.int(1, "Zigzag Width", minval=1, maxval=5, group="Zigzag")

// ─── Displacement Candle ───────────────────────────────────────
dispEnabled    = input.bool(true,  "Tag BOS/CHoCH on Displacement",  group="Displacement")
dispThreshold  = input.float(20.0, "Counter-Wick Max %", minval=1.0, maxval=50.0, step=1.0, group="Displacement")
useBodyFilter  = input.bool(false, "Require larger-than-average body", group="Displacement")
bodyMultiplier = input.float(1.5,  "Body Size Multiplier",  minval=1.0, maxval=5.0, step=0.1, group="Displacement")
bodyLookback   = input.int(5,      "Body Avg Lookback (bars)", minval=2, maxval=50, group="Displacement")
dispMarkerCol  = input.color(color.yellow, "Displacement Marker Color", group="Displacement")

// ─── Position / Backtest ───────────────────────────────────────
showPositions = input.bool(true,  "Show Position Boxes",            group="Position Box")
runBacktest   = input.bool(true,  "Execute trades for backtest",    group="Position Box")
useNextOpen   = input.bool(true,  "Enter at next bar's open",       group="Position Box")
atrLength     = input.int(14,     "ATR Length", minval=1,           group="Position Box")
boxRR         = input.float(1.5,  "Risk:Reward",   minval=0.1, maxval=10.0, step=0.1, group="Position Box")
boxLength     = input.int(15,     "Box Length (bars)", minval=1, maxval=500, group="Position Box")
atrHighThresh = input.float(20.0, "ATR High Threshold",  group="Position Box", inline="hi")
atrHighStop   = input.float(50.0, " → SL points",        group="Position Box", inline="hi")
atrLowThresh  = input.float(7.0,  "ATR Low Threshold",   group="Position Box", inline="lo")
atrLowStop    = input.float(16.5, " → SL points",        group="Position Box", inline="lo")
atrMidStop    = input.float(25.0, "Mid SL points (between thresholds)", group="Position Box")
tpCol         = input.color(color.new(color.green, 75), "Take Profit Fill", group="Position Box")
slCol         = input.color(color.new(color.red,   75), "Stop Loss Fill",   group="Position Box")
entryLineCol  = input.color(color.gray, "Entry Line Color", group="Position Box")

// ─── Risk Sizing ───────────────────────────────────────────────
useRiskSizing = input.bool(true,  "Auto position sizing by risk %", group="Risk Sizing")
riskPct       = input.float(5.0,  "Initial Risk %",        minval=0.1, maxval=100.0, step=0.1, group="Risk Sizing")
addThreshold  = input.float(3.0,  "Add contract when risk drops below %", minval=0.1, maxval=100.0, step=0.1, group="Risk Sizing")
maxRiskPct    = input.float(5.0,  "Max total risk %",      minval=0.1, maxval=100.0, step=0.1, group="Risk Sizing")
pointValueOvr = input.float(2.0, "Point Value ($ per point per contract, MNQ=2 / NQ=20 / MES=5 / ES=50)", minval=0.0, group="Risk Sizing")

// ─── Stats Table ───────────────────────────────────────────────
showStats     = input.bool(true, "Show Stats Table", group="Stats")
tablePos      = input.string("top_right", "Table Position",
     options=["top_left","top_right","bottom_left","bottom_right"], group="Stats")
tableTextCol  = input.color(color.white, "Text Color", group="Stats")
tableBgCol    = input.color(color.new(color.black, 30), "Background", group="Stats")

// ─── Trading Hours ─────────────────────────────────────────────
session1On = input.bool(false,        "Session 1",    group="Trading Hours", inline="s1")
session1Tm = input.session("0930-1100", "",           group="Trading Hours", inline="s1")
session2On = input.bool(false,        "Session 2",    group="Trading Hours", inline="s2")
session2Tm = input.session("1400-1530", "",           group="Trading Hours", inline="s2")
shadeSess  = input.bool(true,  "Shade active sessions on chart", group="Trading Hours")
sessShadeCol = input.color(color.new(color.blue, 92), "Session Shade Color", group="Trading Hours")

inSession1   = session1On and not na(time(timeframe.period, session1Tm))
inSession2   = session2On and not na(time(timeframe.period, session2Tm))
anySessionOn = session1On or session2On
canTrade     = not anySessionOn or inSession1 or inSession2

bgcolor(shadeSess and (inSession1 or inSession2) ? sessShadeCol : na, title="Session Shade")

// ─── Swing detection ───────────────────────────────────────────
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,  leftBars, rightBars)

plotshape(showPivots ? ph : na, title="Pivot High", style=shape.triangledown,
     location=location.abovebar, color=color.new(pivotHighCol, 50), size=size.tiny, offset=-rightBars)
plotshape(showPivots ? pl : na, title="Pivot Low",  style=shape.triangleup,
     location=location.belowbar, color=color.new(pivotLowCol, 50), size=size.tiny, offset=-rightBars)

// ─── State ─────────────────────────────────────────────────────
var float swingHigh      = na
var int   swingHighBar   = 0
var bool  swingHighFired = false
var float swingLow       = na
var int   swingLowBar    = 0
var bool  swingLowFired  = false

if not na(ph)
    swingHigh      := ph
    swingHighBar   := bar_index - rightBars
    swingHighFired := false

if not na(pl)
    swingLow      := pl
    swingLowBar   := bar_index - rightBars
    swingLowFired := false

// ─── Displacement check ───────────────────────────────────────
totalUp   = high - open
totalDown = open - low
topWick   = high - close
botWick   = close - low

body    = math.abs(close - open)
avgBody = ta.sma(body, bodyLookback)[1]
bigBody = not useBodyFilter or (not na(avgBody) and body > avgBody * bodyMultiplier)

isBullDisp = close > open and totalUp   > 0 and (topWick / totalUp)   * 100 < dispThreshold and bigBody
isBearDisp = close < open and totalDown > 0 and (botWick / totalDown) * 100 < dispThreshold and bigBody

// ─── Break detection ───────────────────────────────────────────
upPx = useClose ? close : high
dnPx = useClose ? close : low

var int bias = 0

bullBOS   = false
bullCHoCH = false
bearBOS   = false
bearCHoCH = false

if not na(swingHigh) and upPx > swingHigh and not swingHighFired
    if bias == 1
        bullBOS := true
    else
        bullCHoCH := true
    swingHighFired := true
    bias := 1

if not na(swingLow) and dnPx < swingLow and not swingLowFired
    if bias == -1
        bearBOS := true
    else
        bearCHoCH := true
    swingLowFired := true
    bias := -1

// ─── Draw BOS/CHoCH lines ──────────────────────────────────────
if bullBOS or bullCHoCH
    col = bullCHoCH ? bullCHoCHCol : bullBOSCol
    txt = bullCHoCH ? "CHoCH" : "BOS"
    if dispEnabled and isBullDisp
        txt := txt + " + DC"
    line.new(swingHighBar, swingHigh, bar_index, swingHigh,
         color=col, style=line.style_solid, width=lineW)
    if showLabels
        midBar = math.floor((swingHighBar + bar_index) / 2)
        label.new(midBar, swingHigh, txt,
             color=col, textcolor=color.white,
             style=label.style_label_down, size=size.small)

if bearBOS or bearCHoCH
    col = bearCHoCH ? bearCHoCHCol : bearBOSCol
    txt = bearCHoCH ? "CHoCH" : "BOS"
    if dispEnabled and isBearDisp
        txt := txt + " + DC"
    line.new(swingLowBar, swingLow, bar_index, swingLow,
         color=col, style=line.style_solid, width=lineW)
    if showLabels
        midBar = math.floor((swingLowBar + bar_index) / 2)
        label.new(midBar, swingLow, txt,
             color=col, textcolor=color.white,
             style=label.style_label_up, size=size.small)

plotshape(dispEnabled and (bullBOS or bullCHoCH) and isBullDisp ? high : na,
     title="Bullish Break Displacement",
     style=shape.diamond, location=location.abovebar, color=dispMarkerCol, size=size.tiny)
plotshape(dispEnabled and (bearBOS or bearCHoCH) and isBearDisp ? low : na,
     title="Bearish Break Displacement",
     style=shape.diamond, location=location.belowbar, color=dispMarkerCol, size=size.tiny)

// ─── Position Box + Strategy Execution ─────────────────────────
atrVal = ta.atr(atrLength)
stopDist = atrVal >= atrHighThresh ? atrHighStop : atrVal >= atrLowThresh ? atrMidStop : atrLowStop

bullDispEvent = (bullBOS or bullCHoCH) and isBullDisp
bearDispEvent = (bearBOS or bearCHoCH) and isBearDisp

// A signal is only valid if we're in session AND no position is currently open.
// Same gate is used for both the visual position box and the strategy entry,
// so a box only ever appears for a trade that actually got placed.
validBullEntry = bullDispEvent and canTrade and strategy.position_size == 0
validBearEntry = bearDispEvent and canTrade and strategy.position_size == 0

drawLong  = showPositions and (useNextOpen ? validBullEntry[1] : validBullEntry)
drawShort = showPositions and (useNextOpen ? validBearEntry[1] : validBearEntry)

if drawLong
    entry = useNextOpen ? open : close
    sl    = entry - stopDist
    tp    = entry + stopDist * boxRR
    box.new(bar_index, tp, bar_index + boxLength, entry,
         bgcolor=tpCol, border_color=color.new(color.green, 50),
         text="TP " + str.tostring(tp, format.mintick),
         text_color=color.white, text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center)
    box.new(bar_index, entry, bar_index + boxLength, sl,
         bgcolor=slCol, border_color=color.new(color.red, 50),
         text="SL " + str.tostring(sl, format.mintick),
         text_color=color.white, text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center)
    line.new(bar_index, entry, bar_index + boxLength, entry,
         color=entryLineCol, width=1)

if drawShort
    entry = useNextOpen ? open : close
    sl    = entry + stopDist
    tp    = entry - stopDist * boxRR
    box.new(bar_index, entry, bar_index + boxLength, tp,
         bgcolor=tpCol, border_color=color.new(color.green, 50),
         text="TP " + str.tostring(tp, format.mintick),
         text_color=color.white, text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center)
    box.new(bar_index, sl, bar_index + boxLength, entry,
         bgcolor=slCol, border_color=color.new(color.red, 50),
         text="SL " + str.tostring(sl, format.mintick),
         text_color=color.white, text_size=size.tiny,
         text_halign=text.align_right, text_valign=text.align_center)
    line.new(bar_index, entry, bar_index + boxLength, entry,
         color=entryLineCol, width=1)

// Strategy trades (entries fill on next bar's open by default)
var float entryStopDist = na
var float origEntry     = na

// Capture / clear original entry on position transitions
positionJustOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
positionJustClosed = strategy.position_size == 0 and strategy.position_size[1] != 0

if positionJustOpened
    origEntry := strategy.position_avg_price
if positionJustClosed
    origEntry     := na
    entryStopDist := na

// Point value (override or symbol-supplied)
ptVal = pointValueOvr > 0 ? pointValueOvr : syminfo.pointvalue

// Per-contract risk in $
perContractRisk(stopDistance) =>
    stopDistance * ptVal

// Initial qty so that qty * stopDist * ptVal ≈ riskPct% of equity
initialQty(stopDistance) =>
    riskDollars = riskPct / 100.0 * strategy.equity
    perRisk     = perContractRisk(stopDistance)
    q           = perRisk > 0 ? math.floor(riskDollars / perRisk) : 1
    math.max(q, 1)

// Initial entries
if runBacktest and validBullEntry
    q = useRiskSizing ? initialQty(stopDist) : 1
    strategy.entry("Long", strategy.long, qty=q)
    entryStopDist := stopDist

if runBacktest and validBearEntry
    q = useRiskSizing ? initialQty(stopDist) : 1
    strategy.entry("Short", strategy.short, qty=q)
    entryStopDist := stopDist

// Pyramid: add 1 contract when current risk % drops below threshold, capped by max %
if runBacktest and useRiskSizing and strategy.position_size != 0 and not na(entryStopDist) and strategy.equity > 0
    curQty     = math.abs(strategy.position_size)
    curRisk    = curQty * perContractRisk(entryStopDist)
    curRiskPct = curRisk / strategy.equity * 100.0
    if curRiskPct < addThreshold
        newRiskPct = (curQty + 1) * perContractRisk(entryStopDist) / strategy.equity * 100.0
        if newRiskPct <= maxRiskPct
            if strategy.position_size > 0
                strategy.entry("Long",  strategy.long,  qty=1)
            else
                strategy.entry("Short", strategy.short, qty=1)

// Exit using the ORIGINAL entry's SL/TP (does not move as we pyramid)
if strategy.position_size > 0 and not na(entryStopDist) and not na(origEntry)
    strategy.exit("Long Exit", from_entry="Long",
         stop=origEntry - entryStopDist,
         limit=origEntry + entryStopDist * boxRR)

if strategy.position_size < 0 and not na(entryStopDist) and not na(origEntry)
    strategy.exit("Short Exit", from_entry="Short",
         stop=origEntry + entryStopDist,
         limit=origEntry - entryStopDist * boxRR)

// ─── Zigzag ────────────────────────────────────────────────────
var int   zzLastBar    = na
var float zzLastPrice  = na
var bool  zzLastIsHigh = false
var line  zzLastLine   = na

if showZigzag and not na(ph)
    phBar = bar_index - rightBars
    phPx  = ph
    if na(zzLastBar)
        zzLastBar    := phBar
        zzLastPrice  := phPx
        zzLastIsHigh := true
    else if zzLastIsHigh
        if phPx > zzLastPrice
            zzLastBar   := phBar
            zzLastPrice := phPx
            if not na(zzLastLine)
                line.set_x2(zzLastLine, phBar)
                line.set_y2(zzLastLine, phPx)
    else
        zzLastLine := line.new(zzLastBar, zzLastPrice, phBar, phPx,
             color=zigzagCol, width=zigzagW)
        zzLastBar    := phBar
        zzLastPrice  := phPx
        zzLastIsHigh := true

if showZigzag and not na(pl)
    plBar = bar_index - rightBars
    plPx  = pl
    if na(zzLastBar)
        zzLastBar    := plBar
        zzLastPrice  := plPx
        zzLastIsHigh := false
    else if not zzLastIsHigh
        if plPx < zzLastPrice
            zzLastBar   := plBar
            zzLastPrice := plPx
            if not na(zzLastLine)
                line.set_x2(zzLastLine, plBar)
                line.set_y2(zzLastLine, plPx)
    else
        zzLastLine := line.new(zzLastBar, zzLastPrice, plBar, plPx,
             color=zigzagCol, width=zigzagW)
        zzLastBar    := plBar
        zzLastPrice  := plPx
        zzLastIsHigh := false

// ─── Stats: Sharpe ratio (running) ─────────────────────────────
var float prevEq   = na
var float sumRet   = 0.0
var float sumRetSq = 0.0
var int   nRet     = 0

if not na(prevEq) and prevEq > 0
    r = (strategy.equity - prevEq) / prevEq
    sumRet   += r
    sumRetSq += r * r
    nRet     += 1
prevEq := strategy.equity

avgRet      = nRet > 0  ? sumRet / nRet : 0.0
varRet      = nRet > 1  ? math.max(sumRetSq / nRet - avgRet * avgRet, 0.0) : 0.0
stdRet      = math.sqrt(varRet)
barSeconds  = timeframe.in_seconds(timeframe.period)
barsPerYear = barSeconds > 0 ? 365.0 * 24.0 * 60.0 * 60.0 / barSeconds : 0.0
sharpe      = stdRet > 0 ? (avgRet / stdRet) * math.sqrt(barsPerYear) : 0.0

// ─── Stats Table ───────────────────────────────────────────────
tablePosition = tablePos == "top_left"     ? position.top_left     :
                 tablePos == "top_right"    ? position.top_right    :
                 tablePos == "bottom_left"  ? position.bottom_left  :
                 position.bottom_right

var table statsTable = table.new(position.top_right, 2, 7, border_width=1)

if showStats and barstate.islast
    table.delete(statsTable)
    statsTable := table.new(tablePosition, 2, 7, border_width=1, bgcolor=tableBgCol)

    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    pfTxt   = na(pf) ? "—" : str.tostring(pf, "#.##")

    table.cell(statsTable, 0, 0, "Stats",          bgcolor=color.new(color.gray, 30), text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 0, "",                bgcolor=color.new(color.gray, 30))
    table.cell(statsTable, 0, 1, "Total Trades",    text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 1, str.tostring(strategy.closedtrades), text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 0, 2, "Win Rate",        text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 2, str.tostring(winRate, "#.##") + "%", text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 0, 3, "Net P&L",         text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 3, "$" + str.tostring(strategy.netprofit, "#.##"),
         text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(statsTable, 0, 4, "Profit Factor",   text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 4, pfTxt,             text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 0, 5, "Max Drawdown",    text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 5, "$" + str.tostring(strategy.max_drawdown, "#.##"),
         text_color=color.red, text_size=size.small)
    table.cell(statsTable, 0, 6, "Sharpe (approx)", text_color=tableTextCol, text_size=size.small)
    table.cell(statsTable, 1, 6, str.tostring(sharpe, "#.##"), text_color=tableTextCol, text_size=size.small)

// ─── Alerts ────────────────────────────────────────────────────
alertcondition(bullBOS,   "Bullish BOS",   "Bullish break of structure")
alertcondition(bearBOS,   "Bearish BOS",   "Bearish break of structure")
alertcondition(bullCHoCH, "Bullish CHoCH", "Change of character: trend turning bullish")
alertcondition(bearCHoCH, "Bearish CHoCH", "Change of character: trend turning bearish")
alertcondition((bullBOS or bullCHoCH) and isBullDisp, "Bullish break + Displacement", "Bullish BOS/CHoCH on a displacement candle")
alertcondition((bearBOS or bearCHoCH) and isBearDisp, "Bearish break + Displacement", "Bearish BOS/CHoCH on a displacement candle")
